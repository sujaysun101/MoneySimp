# Names only. Do not put real secrets in this file.

# Gemini (server only). Any one of these enables live model calls.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=
AI_MODEL=

# Signs the demo-mode and Firebase session cookies. Set a long random value in production.
DEMO_SESSION_SECRET=

# Optional override for Firebase ID token checks. The app already ships a client config.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=

# Yodlee bank linking. Leave blank to keep manual entry and demo mode.
NEXT_PUBLIC_YODLEE_CLIENT_ID=
YODLEE_SECRET=
NEXT_PUBLIC_YODLEE_ENV=
NEXT_PUBLIC_APP_URL=

# Feedback email and speech features. Not required for the demo household.
RESEND_API_KEY=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
